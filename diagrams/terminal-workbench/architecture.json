  "cards": [
    {
      "dot": "cyan",
      "title": "Two paths, one execution authority",
      "items": [
        "Automatic task browsing reads existing local evidence and origin-cached remote observations. No background SSH, repair or publication.",
        "Explicit controls pass typed requests through Workbench to existing operation owners. Team, schedule and System owners follow the same frontend boundary; their storage is omitted from this task-focused view."
      ]
    },
    {
      "dot": "amber",
      "title": "Dated, disposable search",
      "items": [
        "Metadata and last-observed status codes are indexed; prompts, results, logs, credentials and environment content are excluded.",
        "Coverage is eventual and visibly incomplete during indexing. Cache rebuild never changes source records; rows never authorize another launch."
      ]
    },
    {
      "dot": "rose",
      "title": "Closing the terminal is not task cancellation",
      "items": [
        "Session cancellation ends cooperative reads only. Effects keep their existing owner deadlines and remain tracked across navigation.",
        "Force exit restores the terminal where possible and prints unresolved resource references. Inspect the same operation; never automatically replay uncertain admission."
      ]
    }
  ]
