  "cards": [
    {
      "dot": "cyan",
      "title": "Static admission, fresh launch",
      "items": [
        "Managed runtime-only profiles use ProfileCandidate.Admit without a version/help worker",
        "Immutable metadata binds RuntimePreflightSHA256 with empty ProviderVersion; launch evidence records the observed version",
        "Mixed/native policy projections, CCR selection, custom runners and historical tasks retain strict admission inspection",
        "freshPreflightProfile probes runtime capabilities; finalizeCandidate validates, then matchPreparedProfile checks the admitted contract before Start",
        "No shared admission capability cache authorizes execution"
      ]
    },
    {
      "dot": "cyan",
      "title": "Ownership",
      "items": [
        "Pueue owns scheduling and worker-row state",
        "The guardian owns native scope, stopping, and durable exact child Wait",
        "delegate-run owns provider Start/Wait, capture, and sealing",
        "The workspace coordinator owns use \u2192 capture \u2192 reusable under its use-owner lease",
        "Git worktree metadata commands share one common-directory lease; execution still uses the existing runner"
      ]
    },
    {
      "dot": "emerald",
      "title": "Evidence",
      "items": [
        "provider.exit seals raw evidence",
        "outcome.json is terminal authority",
        "result.txt and publish.reject are payload evidence",
        "Workspace capture receipts have independent authority; they never rewrite provider outcomes",
        "Git snapshots cover Git-visible content; ignored files, runtime state and submodule contents are outside that contract"
      ]
    },
    {
      "dot": "violet",
      "title": "Provider surface",
      "items": [
        "Behavior and identity establish compatibility",
        "Live acceptance is auth-gated; BLOCKED is neutral",
        "Unsupported modes fail before admission",
        "Continuation creates a successor linked to its recorded predecessor"
      ]
    },
    {
      "dot": "amber",
      "title": "Optional isolation and explicit retention",
      "items": [
        "Non-Git and ordinary caller-directory tasks remain available without managed isolation",
        "Managed writes use detached checkouts; verification runs inside the retained checkout",
        "Capture and cleanup require exact helper/provider lifetime closure; failed evidence retains the workspace",
        "The lead chooses release and forget; no background TTL deletion or automatic code landing"
      ]
    },
    {
      "dot": "cyan",
      "title": "Workspace coordination uses existing components",
      "items": [
        "The delegate application owns the workspace coordinator; it is not another service or process owner",
        "Its finite Git and verification helpers use the existing Pueue \u2192 guardian \u2192 delegate-run execution path",
        "A completed guardian or later observer wakes the same coordinator; the use-owner lease selects its sole writer",
        "The records node contains independent provider outcomes, helper results and workspace capture receipts"
      ]
    },
    {
      "dot": "slate",
      "title": "Committed source snapshot",
      "items": [
        "Source revision: cb71d7474371",
        "Node source links identify committed code",
        "Admission and runtime preflight retain separate owners"
      ]
    }
  ]
}
