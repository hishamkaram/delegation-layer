  "cards": [
    {
      "dot": "cyan",
      "title": "Source owners",
      "items": [
        "app composes the CLI; tasklifecycle owns task control and the fresh-task resource gate. The provider catalog is part of admission preparation.",
        "admission owns profile decisions; inspection and Pueue runtime implementations stay behind their public boundaries.",
        "supervisor owns binding and submission gates; Pueue owns rows. guardian owns native lifetime.",
        "execution owns Start/Wait and sealing; taskdir owns predicate evaluation and outcome commit.",
        "The guardian records each observed native launch before acknowledgement (internal/guardian/control.go:198-225).",
        "Existing-task status enters ObserveTaskSupervisor; strict preparation and mutation keep their completion gates."
      ]
    },
    {
      "dot": "rose",
      "title": "Fresh-task resource admission",
      "items": [
        "resourceadmission owns sampling and the pure decision; tasklifecycle owns the gate. Nothing is persisted or cached across commands.",
        "Fresh dispatch is checked before workspace, provider or supervisor preparation; continue is checked after its predecessor loads.",
        "Before task creation, the check is refreshed only when it is older than 5 s or the execution target changed.",
        "Confirmed pressure (3 sustained intervals, or critical memory) refuses: task_record not_created, retry_later, retry_after_seconds.",
        "Unknown metric: an unavailable metric never refuses by itself. If no independent pressure is confirmed, the check lets admission continue with resource_admission unknown and a warning; later admission steps may still fail.",
        "Running tasks, status, collect, cancel and existing-task recovery are never checked; nothing is killed or throttled."
      ]
    },
    {
      "dot": "amber",
      "title": "Admission and launch",
      "items": [
        "Managed runtime-only admission stores a static capability contract; other paths keep strict admission inspection.",
        "Every managed launch probes the current runtime inside its guardian scope and matches the admitted contract before Start.",
        "Legacy logical-owner adoption is create-once and precedes scheduling changes."
      ]
    },
    {
      "dot": "emerald",
      "title": "Independent evidence",
      "items": [
        "provider.exit seals raw evidence; outcome.json alone establishes a terminal verdict.",
        "TaskDir, inspection journals and workspace journals have separate record writers and authority.",
        "Full maintenance sends all current rows to the same durable authorizer. With terminal events enabled, event-only starts from inbox IDs.",
        "Cached and fresh status rows require the canonical generation check under a shared lease; deferral is derived per reconciliation attempt."
      ]
    },
    {
      "dot": "violet",
      "title": "Optional managed workspaces",
      "items": [
        "workspaces owns use \u2192 capture \u2192 reusable under the resource use-owner lease.",
        "Finite Git and verification helpers reuse Pueue \u2192 guardian \u2192 delegate-run; capture requires exact lifetime closure.",
        "Workspace receipts never rewrite provider outcomes. The lead verifies the retained checkout and explicitly releases or forgets it."
      ]
    }
  ]
}
