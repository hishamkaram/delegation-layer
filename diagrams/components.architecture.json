  "cards": [
    {
      "dot": "cyan",
      "title": "Ownership",
      "items": [
        "The core owns admission, scheduling, execution, capture, sealing, collection, and publication",
        "Adapters own native arguments, policy, identity, and evidence interpretation",
        "Pueue owns process lifetime and stopping"
      ]
    },
    {
      "dot": "emerald",
      "title": "Evidence",
      "items": [
        "provider.exit seals the raw provider evidence before publication",
        "outcome.json is the sole terminal authority",
        "result.txt and publish.reject are payload evidence, not completion signals"
      ]
    },
    {
      "dot": "violet",
      "title": "Provider surface",
      "items": [
        "Five discoverable profiles are checked dynamically at runtime",
        "Pi exposes read-only only because its native write tools lack a workspace boundary",
        "Unsupported modes and options fail before supervisor admission"
      ]
    }
  ]
