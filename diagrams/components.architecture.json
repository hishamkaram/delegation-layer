        "focus": [
          "caller",
          "delegate",
          "catalog",
          "inspection",
          "store",
          "pueue",
          "acceptance"
        ],
        "note": "The CLI can preflight a named provider or automatically select one, then persists the request and submits one supervised job."
      },
      {
        "id": "execution",
        "label": "Execution and publication",
        "focus": [
          "pueue",
          "guardian",
          "runner",
          "providers",
          "predicate",
          "store",
          "acceptance"
        ],
        "note": "Delegate stages, receipts, then enqueues the row. The guardian owns lifetime; delegate-run owns execution, capture, and publication."
      },
      {
        "id": "recovery",
        "label": "Observation and recovery",
        "focus": [
          "caller",
          "delegate",
          "store",
          "pueue",
          "guardian",
          "runner"
        ],
        "note": "Observation reads durable state; guardian recovery resumes the same lifetime policy and continuation creates a linked successor."
      }
    ],
