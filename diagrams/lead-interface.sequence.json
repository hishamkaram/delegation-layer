  "cards": [
    {
      "dot": "cyan",
      "title": "Admission",
      "items": [
        "The request is persisted before supervisor submission",
        "A stashed row is receipted durably before its exact ID is enqueued",
        "Runtime capability evidence is checked before launch",
        "The caller receives a task id and separate admission/liveness fields"
      ]
    },
    {
      "dot": "emerald",
      "title": "Publication",
      "items": [
        "Pueue owns queueing and guardian-row state",
        "The guardian owns native stopping and durable exact child-Wait proof",
        "delegate-run owns provider Start/Wait, capture, and sealing",
        "Only outcome.json establishes a terminal verdict"
      ]
    },
    {
      "dot": "violet",
      "title": "Observation",
      "items": [
        "Collection reads committed evidence without launching work",
        "Cancellation persists one request; the lifetime lease selects its sole stopping owner",
        "Continuation creates a new task with an exact predecessor"
      ]
    }
  ]
