  "messages": [
    {
      "id": "dispatch",
      "from": "caller",
      "to": "delegate",
      "y": 170,
      "label": "preflight / dispatch --auto --brief FILE",
      "variant": "emphasis"
    },
    {
      "id": "probe",
      "from": "delegate",
      "to": "inspect",
      "y": 198,
      "label": "run bounded version/help capability probe"
    },
    {
      "id": "probe-facts",
      "from": "inspect",
      "to": "delegate",
      "y": 226,
      "label": "observed version, flags, executable identity",
      "note": "Version is descriptive evidence; required behavior flags and executable identity establish compatibility.",
      "variant": "return"
    },
    {
      "id": "persist",
      "from": "delegate",
      "to": "store",
      "y": 254,
      "label": "persist brief, request, metadata",
      "variant": "emphasis",
      "note": "The immutable request and metadata are durable before supervisor admission."
    },
    {
      "id": "enqueue",
      "from": "delegate",
      "to": "pueue",
      "y": 282,
      "label": "stage row \u00b7 persist exact receipt \u00b7 enqueue exact ID",
      "note": "A managed row cannot launch before Delegate durably owns its exact supervisor identity."
    },
    {
      "id": "accepted",
      "from": "delegate",
      "to": "caller",
      "y": 310,
      "label": "task id + admission/status fields",
      "variant": "return"
    },
    {
      "id": "schedule",
      "from": "pueue",
      "to": "guardian",
      "y": 350,
      "label": "schedule guardian row",
      "variant": "emphasis"
    },
    {
      "id": "scope-intent",
      "from": "guardian",
      "to": "store",
      "y": 378,
      "label": "persist scope intent + registration"
    },
    {
      "id": "spawn",
      "from": "guardian",
      "to": "runner",
      "y": 406,
      "label": "start exact managed child",
      "variant": "emphasis"
    },
    {
      "id": "reconstruct",
      "from": "runner",
      "to": "store",
      "y": 434,
      "label": "read receipt and recheck recorded profile"
    },
    {
      "id": "hello",
      "from": "runner",
      "to": "guardian",
      "y": 462,
      "label": "hello + provider launch request"
    },
    {
      "id": "launch-record",
      "from": "guardian",
      "to": "store",
      "y": 490,
      "label": "persist worker and launch identity"
    },
    {
      "id": "launch-ack",
      "from": "guardian",
      "to": "runner",
      "y": 518,
      "label": "authorize recorded launch",
      "variant": "return"
    },
    {
      "id": "invoke",
      "from": "runner",
      "to": "provider",
      "y": 546,
      "label": "invoke one bounded provider turn",
      "variant": "emphasis"
    },
    {
      "id": "capture",
      "from": "provider",
      "to": "runner",
      "y": 574,
      "label": "stdout, stderr, identity, exit",
      "variant": "return"
    },
    {
      "id": "seal",
      "from": "runner",
      "to": "store",
      "y": 602,
      "label": "provider.exit seals raw evidence",
      "variant": "emphasis"
    },
    {
      "id": "interpret",
      "from": "runner",
      "to": "predicate",
      "y": 630,
      "label": "validate sealed behavior"
    },
    {
      "id": "outcome",
      "from": "predicate",
      "to": "store",
      "y": 658,
      "label": "commit outcome.json: committed or rejected",
      "variant": "emphasis",
      "note": "outcome.json is the terminal authority; result.txt and publish.reject are payload evidence."
    },
    {
      "id": "worker-close",
      "from": "runner",
      "to": "guardian",
      "y": 686,
      "label": "persist exact child Wait after capture",
      "variant": "return"
    },
    {
      "id": "lifetime-proof",
      "from": "guardian",
      "to": "store",
      "y": 714,
      "label": "durable child Wait \u00b7 empty scope \u00b7 termination",
      "variant": "emphasis",
      "note": "Pueue row completion alone is not native termination or provider-result authority."
    },
    {
      "id": "observe",
      "from": "caller",
      "to": "delegate",
      "y": 739,
      "label": "status / logs / collect"
    },
    {
      "id": "read",
      "from": "delegate",
      "to": "store",
      "y": 767,
      "label": "read durable state; never relaunch"
    },
    {
      "id": "observed",
      "from": "store",
      "to": "delegate",
      "y": 795,
      "label": "state, descriptors, outcome, continuation",
      "variant": "return"
    },
    {
      "id": "returned",
      "from": "delegate",
      "to": "caller",
      "y": 823,
      "label": "bounded control response",
      "variant": "return"
    },
    {
      "id": "cancel",
      "from": "caller",
      "to": "delegate",
      "y": 851,
      "label": "cancel TASK_ID",
      "variant": "dashed"
    },
    {
      "id": "cancel-request",
      "from": "delegate",
      "to": "store",
      "y": 879,
      "label": "persist immutable user stop request",
      "variant": "emphasis",
      "note": "The durable request is the single cancellation intent; a queue row is never native lifetime authority."
    },
    {
      "id": "guardian-cancel",
      "from": "guardian",
      "to": "store",
      "y": 907,
      "label": "active owner: terminate scope + record empty proof",
      "variant": "dashed"
    },
    {
      "id": "stop",
      "from": "delegate",
      "to": "pueue",
      "y": 935,
      "label": "otherwise: stop row while holding lifetime lease",
      "variant": "dashed",
      "note": "Direct row mutation is allowed only when cancellation owns the lease, so no guardian can launch or own a provider concurrently."
    },
    {
      "id": "continue",
      "from": "caller",
      "to": "delegate",
      "y": 963,
      "label": "continue --task TASK_ID [--brief FILE]",
      "variant": "emphasis"
    }
