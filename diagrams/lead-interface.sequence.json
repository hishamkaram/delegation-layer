{
  "schema_version": 1,
  "diagram_type": "sequence",
  "meta": {
    "title": "Delegation Layer \u2014 One Task Lifecycle",
    "column_fit": "spread",
    "quality_profile": "showcase",
    "views": [
      {
        "id": "admission",
        "label": "Admission",
        "focus": [
          "caller",
          "delegate",
          "inspect",
          "store",
          "pueue"
        ],
        "note": "The request is validated, capability-checked, persisted, and queued before the caller receives the task id."
      },
      {
        "id": "publish",
        "label": "Run and publish",
        "focus": [
          "pueue",
          "guardian",
          "runner",
          "provider",
          "predicate",
          "store"
        ],
        "note": "Delegate stages, receipts, then enqueues the row. The guardian owns lifetime; delegate-run owns execution, capture, and publication."
      },
      {
        "id": "observe",
        "label": "Observe and continue",
        "focus": [
          "caller",
          "delegate",
          "store",
          "pueue",
          "guardian"
        ],
        "note": "Collection reads durable evidence; cancellation persists one request, and the lifetime lease selects the sole stopping owner."
      }
    ],
    "output": "diagrams/lead-interface.html",
    "viewBox": [
      1680,
      1080
    ]
  },
  "participants": [
