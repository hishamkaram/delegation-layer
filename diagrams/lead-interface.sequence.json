{
  "schema_version": 1,
  "diagram_type": "sequence",
  "meta": {
    "title": "Delegation Layer — One Task Lifecycle",
    "viewBox": [
      1600,
      800
    ],
    "column_fit": "spread",
    "quality_profile": "showcase",
    "views": [
      {
        "id": "admission",
        "label": "Admission",
        "focus": [
          "caller",
          "delegate",
          "inspect",
          "store",
          "pueue"
        ],
        "note": "The request is validated, capability-checked, persisted, and queued before the caller receives the task id."
      },
      {
        "id": "publish",
        "label": "Run and publish",
        "focus": [
          "pueue",
          "runner",
          "provider",
          "predicate",
          "store"
        ],
        "note": "The supervisor owns delegate-run, which seals provider evidence before the predicate can commit an outcome."
      },
      {
        "id": "observe",
        "label": "Observe and continue",
        "focus": [
          "caller",
          "delegate",
          "store",
          "pueue"
        ],
        "note": "Collection reads durable evidence without launching work; cancellation and continuation remain explicit operations."
      }
    ]
  },
  "participants": [
