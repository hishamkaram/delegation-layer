  "cards": [
    {
      "dot": "cyan",
      "title": "The whole interface",
      "items": [
        "Five commands: dispatch · status · logs · collect · cancel",
        "Config is intent — model, permission, effort — resolved per provider",
        "status returns WHERE to look: result path, transcript, session id"
      ]
    },
    {
      "dot": "emerald",
      "title": "Why it survives the lead",
      "items": [
        "dispatch returns a task id and exits — nothing is held open",
        "Every command is a fresh process reading durable files",
        "The lead can die between any two commands and lose nothing"
      ]
    },
    {
      "dot": "amber",
      "title": "What the lead decides",
      "items": [
        "Four outcomes: usable · recoverable · terminal · undetermined",
        "idle_seconds is reported; the threshold belongs to the lead",
        "admission-unknown is surfaced, never auto-resubmitted — only the lead may relaunch"
      ]
    }
  ]
