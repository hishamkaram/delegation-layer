  "messages": [
    {
      "id": "m-dispatch",
      "from": "lead",
      "to": "cli",
      "y": 180,
      "label": "delegate dispatch --brief brief.md",
      "variant": "emphasis"
    },
    {
      "id": "m-submit",
      "from": "cli",
      "to": "tasks",
      "y": 208,
      "label": "brief.md + task.json + submit.json",
      "variant": "emphasis",
      "note": "submit.json is fsynced BEFORE the supervisor is called, so its absence proves nothing ran."
    },
    {
      "id": "m-add",
      "from": "cli",
      "to": "pueued",
      "y": 236,
      "label": "pueue add --escape --label <task id>",
      "variant": "default"
    },
    {
      "id": "m-spawn",
      "from": "pueued",
      "to": "publisher",
      "y": 264,
      "label": "spawns and owns delegate-run",
      "variant": "emphasis"
    },
    {
      "id": "m-taskid",
      "from": "cli",
      "to": "lead",
      "y": 292,
      "label": "task id, then exit",
      "variant": "return"
    },
    {
      "id": "m-invoke",
      "from": "publisher",
      "to": "worker",
      "y": 320,
      "label": "invokes the provider, waits",
      "variant": "emphasis",
      "note": "delegate-run forks the worker and waits on it. It supervises nothing and signals nothing."
    },
    {
      "id": "m-publish",
      "from": "publisher",
      "to": "tasks",
      "y": 348,
      "label": "raw/ first, then rename on confirmed success",
      "variant": "emphasis",
      "note": "Publication needs adapter-confirmed success, a non-empty answer and no abort marker. Otherwise publish.reject."
    },
    {
      "id": "m-status",
      "from": "lead",
      "to": "cli",
      "y": 376,
      "label": "delegate status <id>",
      "variant": "default"
    },
    {
      "id": "m-ladder",
      "from": "cli",
      "to": "tasks",
      "y": 404,
      "label": "result.txt? publish.reject? which exit?",
      "variant": "default"
    },
    {
      "id": "m-check-pueue",
      "from": "cli",
      "to": "pueued",
      "y": 432,
      "label": "pueue status --json — the label proves admission",
      "variant": "default"
    },
    {
      "id": "m-status-out",
      "from": "cli",
      "to": "lead",
      "y": 460,
      "label": "{state, source, idle, paths}",
      "variant": "return"
    },
    {
      "id": "m-collect",
      "from": "lead",
      "to": "cli",
      "y": 488,
      "label": "delegate collect <id>",
      "variant": "emphasis"
    },
    {
      "id": "m-read",
      "from": "cli",
      "to": "tasks",
      "y": 516,
      "label": "read result.txt, else re-judge raw/",
      "variant": "default",
      "note": "collect never executes a turn. If the publisher died mid-decision, the same predicate runs again over the same bytes."
    },
    {
      "id": "m-answer",
      "from": "cli",
      "to": "lead",
      "y": 544,
      "label": "the worker's answer",
      "variant": "return"
    },
    {
      "id": "m-cancel",
      "from": "lead",
      "to": "cli",
      "y": 572,
      "label": "delegate cancel <id>",
      "variant": "dashed"
    },
    {
      "id": "m-kill",
      "from": "cli",
      "to": "pueued",
      "y": 600,
      "label": "pueue kill <task id>",
      "variant": "dashed"
    }
