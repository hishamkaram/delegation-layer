  "cards": [
    {
      "dot": "cyan",
      "title": "Admission",
      "items": [
        "The request is persisted before supervisor submission",
        "Runtime capability evidence is checked before launch",
        "The caller receives a task id and separate admission/liveness fields"
      ]
    },
    {
      "dot": "emerald",
      "title": "Publication",
      "items": [
        "Pueue owns process lifetime and stopping",
        "Raw streams are sealed before result interpretation",
        "Only outcome.json establishes a terminal verdict"
      ]
    },
    {
      "dot": "violet",
      "title": "Observation",
      "items": [
        "Collection reads committed evidence without launching work",
        "Cancellation requests a supervisor stop and observes its effect",
        "Continuation creates a new task with an exact predecessor"
      ]
    }
  ]
