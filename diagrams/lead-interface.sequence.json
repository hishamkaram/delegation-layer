    "views": [
      {
        "id": "dispatch",
        "label": "Dispatch and return",
        "focus": [
          "lead",
          "cli",
          "tasks",
          "pueued",
          "publisher"
        ],
        "note": "submit.json is written before pueued is called; dispatch then returns a task id."
      },
      {
        "id": "publish",
        "label": "Publication",
        "focus": [
          "publisher",
          "worker",
          "tasks"
        ],
        "note": "delegate-run keeps the raw output, then renames only on adapter-confirmed success."
      },
      {
        "id": "collect",
        "label": "Poll and collect",
        "focus": [
          "lead",
          "cli",
          "tasks",
          "pueued"
        ],
        "note": "Every command is a fresh process reading durable files."
      }
    ]
  },
